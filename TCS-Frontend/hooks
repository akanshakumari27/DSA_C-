// Search

import { useState } from "react";

function Search() {
  const [query, setQuery] = useState("");

  const handleKeyUp = (e) => {
    setQuery(e.target.value);
    console.log("Searching for:", e.target.value);
  };

  return (
    <input type="text" placeholder="Search..." onKeyUp={handleKeyUp} />
  );
}
