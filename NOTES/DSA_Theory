-> What is the difference between Iterative and Recursive Binary Search?

When the function is call using Loop, is known as Iterative Binary Search;
whereas, when the function is call using Recursion, is known as Recursive Binary Search.

// Iterative Binary Search
int main() {
    int arr[] = {1, 2, 3, 4, 5, 6,7};
    int size = sizeof(arr)/sizeof(arr[0]);
    int target = 6;
    int start = 0;
    int end = size - 1;
    bool check = false;
    while(start <= end){   //in best case, we can find target in mid that's y <=
        int mid = (start + end)/2;
        if(target == arr[mid]){
            cout << mid;
            check = true;
            break;
        }else if(target < arr[mid]){
            end = mid - 1;
        }else{
            start = mid + 1;
        }
    }
    if(!check){
        cout<< -1;
    }
    return 0;
}

// Recursive Binary Search
int binarySearchRecursive(int arr[], int start, int end, int target) {
    if(start > end) return -1;       // base case: not found
    int mid = (start + end) / 2;
    if(arr[mid] == target) return mid;
    else if(target < arr[mid]) return binarySearchRecursive(arr, start, mid - 1, target);
    else return binarySearchRecursive(arr, mid + 1, end, target);
}
Call it With:
int index = binarySearchRecursive(arr, 0, size-1, target);
cout << index;

Feature          |  Recursive Binary Search                      |  Iterative Binary Search
----------------   ---------------------------------------------   ----------------------------
Implementation   | Uses recursion                                | Uses loops
Space Complexity | O(log n) (due to recursive calls)             | O(1)
Performance      | Slightly slower due to function call overhead | Faster due to no recursion overhead
Use Case         | Suitable for problems with recursive nature   | More efficient for large inputs
