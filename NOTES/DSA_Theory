-> How do you reverse an array in-place? (means without using extra memory, Only use the same array (no new array))

// Vctor In-built Function
int main() {
    vector<int> v = {1, 2,3, 4, 5,6, 7, 8, 9};
    reverse(v.begin(), v.end());
    for(int i =0; i<9; i++){
        cout<<v[i]<<" ";
    }
    return 0;
}

// Array using 2 pointers
int main() {
    int arr[9] = {1, 2,3, 4, 5,6, 7, 8, 9};
    int i = 0;
    int j = 8;
    while(i<=j){
        int temp = arr[i];  //swap(arr[i], arr[j])
        arr[i] = arr[j];
        arr[j] = temp;
        i++;
        j--;
    }
    for(int i =0; i<9; i++){
        cout<<arr[i]<<" ";
    }
    return 0;
}
